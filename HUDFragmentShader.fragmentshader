#version 330 core

// HUD fragment shader. The colour comes from the vertex and the opacity from the font atlas.

in vec2 UV;
in vec4 fragmentColor;

out vec4 color;

// font atlas, one channel with how much of each pixel the letter covers.
// It also has a white square for the shapes without text
uniform sampler2D Atlas;

void main(){
	color = vec4(fragmentColor.rgb, fragmentColor.a * texture(Atlas, UV).r);
}
